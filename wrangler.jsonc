// Cloudflare Workers static assets, no script: site.yml deploys site/dist here beside GitHub
// Pages, which still serves marola.dev (MIP-0078).
{
  "name": "marola",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "directory": "./site/dist",
    // Without it a missing board would not be a 404, and app.js's "run site-build" hint needs one.
    "not_found_handling": "404-page"
  }
}
