{
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "extraKnownMarketplaces": {
    "marola-devkit": { "source": { "source": "github", "repo": "marola-dev/marola-devkit", "ref": "v0.8.3" } }
  },
  "enabledPlugins": { "marola-devkit@marola-devkit": true },
  "enabledMcpjsonServers": ["playwright", "figma"],
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh stack:*)",
      "Bash(just uprd:*)",
      "Bash(just uprds:*)",
      "Bash(just quality*)",
      "Bash(just site-serve*)",
      "Bash(uprd:*)",
      "Bash(uprds:*)",
      "Bash(stack:*)",
      "Bash(cost-split:*)",
      "Bash(node --check site/static/app.js)",
      "Bash(node scripts/site_check.js*)",
      "Bash(node scripts/redirect_check.js)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(command -v *)",
      "mcp__playwright",
      "mcp__figma"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh stack merge*)",
      "Bash(gh stack unstack*)",
      "Bash(gh stack delete*)",
      "Bash(just site-deploy*)",
      "Bash(gh workflow run site.yml*)"
    ]
  }
}
