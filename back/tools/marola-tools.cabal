cabal-version: 3.0
name:          marola-tools
version:       0.1.0
synopsis:      The repo's own checks and test harnesses, in Haskell (ADR 0007)
license:       MIT
build-type:    Simple

common shared
  default-language:   GHC2021
  default-extensions:
    LambdaCase
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
  ghc-options:        -Wall -Wno-name-shadowing

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Marola.Tools.DesignCheck
    Marola.Tools.ElmFixtures
    Marola.Tools.JsCheck
    Marola.Tools.Client
    Marola.Tools.Net
    Marola.Tools.FakeGithub
    Marola.Tools.Smoke
    Marola.Tools.SmokeStudies
    Marola.Tools.SmokeSubmit
    Marola.Tools.SmokeBoard
    Marola.Tools.PackageSmoke
    Marola.Tools.Main
  build-depends:
    , base                 >=4.18   && <4.19
    , aeson                >=2.2    && <2.3
    , bytestring           >=0.11   && <0.13
    , case-insensitive     >=1.2    && <1.3
    , containers           >=0.6    && <0.8
    , directory            >=1.3    && <1.4
    , filepath             >=1.4    && <1.6
    , http-client          >=0.7    && <0.8
    , http-types           >=0.12.5 && <0.13
    , network              >=3.1    && <3.3
    , process              >=1.6    && <1.7
    , text                 >=2.0    && <2.2
    , vector               >=0.13   && <0.14
    , wai                  >=3.2    && <3.3
    , warp                 >=3.4    && <3.5
    , zlib                 >=0.7    && <0.8

executable marola-tools
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , base
    , marola-tools

test-suite marola-tools-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  build-depends:
    , base
    , marola-tools
    , hspec        >=2.11 && <2.12
    , text
