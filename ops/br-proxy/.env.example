# Copy to .env (gitignored; never commit it) — ops/br-proxy/JOIN.md.
# The proxy's login. The user is any name that tells the admin the node is yours.
BR_PROXY_USER=br-proxy
# Leave empty: `just br-proxy-node up` generates a 24-character password and writes it here.
# Send the line `up` prints only privately (a DM), never in an issue, a PR or a group chat.
BR_PROXY_PASSWORD=
# The port you forward on your router to this machine.
BR_PROXY_PORT=8888
