# Copy to .env (gitignored) and paste the one-off auth key the marola admin sent you (JOIN.md).
# Leave it empty to be asked for it by `just br-proxy-node up` instead.
TS_AUTHKEY=
# The marola admin's Headscale server, https://… (JOIN.md).
HEADSCALE_URL=
# The node's name in the tailnet; something that tells the admin it is yours.
BR_PROXY_NODE_NAME=br-proxy
