<Project Sdk="Microsoft.NET.Sdk">
  <!-- The browser half of the map page: it applies the virtual DOM's operations to the real DOM and carries
       out the commands of `Update`. Fable only (it imports the browser and the two FFI files), so there is no
       .NET test project for it: scripts/client_check.js runs the compiled page in a fake DOM. -->
  <ItemGroup>
    <Compile Include="Ffi.fs" />
    <Compile Include="Dom.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="Effects.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Shared/Marola.Shared.fsproj" />
    <ProjectReference Include="../Core/Marola.Client.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.19.0" />
    <PackageReference Include="Thoth.Json.JavaScript" Version="0.6.0" />
  </ItemGroup>
</Project>
