<Project>
  <!-- The test sources both projects compile: Marola.Tests (Expecto on .NET) and Marola.Tests.Fable (Fable.Mocha on Node). Order matters in F#. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Support.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)TypesTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)BoardTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)CspTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)HtmlTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)NotesTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)TrailsTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)ParityBeachTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)ParityFlowTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)ParityTextTests.fs" />
    <Compile Include="$(MSBuildThisFileDirectory)All.fs" />
  </ItemGroup>
</Project>
