<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>marola-server</AssemblyName>
    <RootNamespace>Marola.Server</RootNamespace>
    <!-- Kestrel, the rate limiter and the compression middleware are in the shared framework: no package for them. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="Security.fs" />
    <Compile Include="Files.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="StudyStore.fs" />
    <Compile Include="PdfIntake.fs" />
    <Compile Include="StudyApi.fs" />
    <Compile Include="Contact.fs" />
    <Compile Include="Inbox.fs" />
    <Compile Include="DevAccount.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Marola.Shared.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- The bundle pulls lib.e_sqlite3 2.1.11, which carries SQLite before 3.50.2 (CVE-2025-6965). 2.1.14 is the newest 2.x lib. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
