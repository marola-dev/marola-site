<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of app/Tests, compiled by Fable and run on Node (just app-test). -->
  <Import Project="../Tests/SharedTests.props" />
  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Marola.Shared.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fable.Mocha has the Expecto API, so the test sources are the same; Thoth.Json.JavaScript reads JSON on Node. -->
    <PackageReference Include="Fable.Mocha" Version="2.17.0" />
    <PackageReference Include="Thoth.Json.JavaScript" Version="0.6.0" />
  </ItemGroup>
</Project>
